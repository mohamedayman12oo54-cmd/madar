# Copy this file to .env and fill in real values before deploying.
# Never commit the real .env file.

DJANGO_SECRET_KEY=change-me-to-a-long-random-value
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-domain.com
DJANGO_TIME_ZONE=Africa/Cairo

# Comma-separated, no trailing slashes, no wildcards.
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-frontend-domain.com

# Postgres example (omit these to fall back to SQLite):
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=madar
# DB_USER=madar
# DB_PASSWORD=change-me
# DB_HOST=localhost
# DB_PORT=5432

# Dev-only: return generated OTP codes in API responses so the flows are
# testable without a real SMS/email provider wired up. Ignored unless
# DJANGO_DEBUG=True regardless of this value.
EXPOSE_OTP_IN_RESPONSE=True
