# Copy this file to .env and fill in real values before deploying.
# NEVER commit the real .env file (it is git-ignored).
#
# With DJANGO_DEBUG=False the app REFUSES TO START on: a missing/placeholder/
# short DJANGO_SECRET_KEY, an empty or "*" DJANGO_ALLOWED_HOSTS, or any
# non-https CORS/CSRF origin.

# >= 50 random characters. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
# Explicit hostnames only (no "*").
DJANGO_ALLOWED_HOSTS=api.your-domain.com
DJANGO_TIME_ZONE=Africa/Cairo

# Comma-separated, https only, no trailing slashes, no wildcards.
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-frontend-domain.com

# --- reverse proxy / client IP (rate limiting depends on this) --------------
# Number of trusted reverse proxies that APPEND the real client address to
# X-Forwarded-For. 0 = trust none (header ignored; safe default). If Django
# sits behind exactly one proxy that you control, set 1.
DJANGO_NUM_PROXIES=0
# Set True ONLY when a TLS-terminating proxy in front of Django overwrites
# X-Forwarded-Proto (otherwise SECURE_SSL_REDIRECT loops or can be spoofed).
DJANGO_BEHIND_TLS_PROXY=False

# --- shared cache for rate-limit counters -----------------------------------
# "db" (default when DEBUG=False; run `python manage.py createcachetable` once
# per deployment) or "locmem" (default in DEBUG; per-process, dev only).
# DJANGO_CACHE_BACKEND=db

# --- HTTPS / HSTS (defaults shown apply when DEBUG=False) --------------------
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_HSTS_SECONDS=2592000
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=True
# DJANGO_HSTS_PRELOAD=True

# PostgreSQL is the only supported database (required):
DB_NAME=madar
DB_USER=madar
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Persistent connections (recommended):
DB_CONN_MAX_AGE=60
DB_CONN_HEALTH_CHECKS=True

# --- OTP delivery: email (Gmail SMTP) -----------------------------------------
# Teachers (signup) and students (activation) may choose to receive the code by
# email. In DEBUG Django defaults to the CONSOLE backend: the email is only
# printed in the runserver terminal and nothing reaches the inbox. To really
# send through Gmail set EMAIL_BACKEND to smtp and fill the rest.
#
# Gmail needs an APP PASSWORD (not the account password):
#   Google Account -> Security -> turn on 2-Step Verification -> App passwords
#   -> create one for "Mail" -> paste the 16 characters below (no spaces).
# Verify the setup (sends a real code to the address you give):
#   python manage.py check_otp_delivery --email you@gmail.com
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Shown to the recipient as the sender. Gmail rewrites it to EMAIL_HOST_USER.
DEFAULT_FROM_EMAIL=Madar <no-reply@your-domain.com>

# --- OTP delivery: SMS ---------------------------------------------------------
# There is NO built-in SMS provider. The default backend only logs and, outside
# DEBUG, refuses to pretend a message was sent. Point this at a class that has
# send(phone, message) (see accounts/delivery.py) once an SMS account exists:
# OTP_SMS_BACKEND=accounts.sms_providers.YourProvider

# --- local development only ---------------------------------------------------
# The OTP code is never returned in API responses (not configurable). Read it
# from the runserver terminal (console email backend) or your real inbox.
# Any EXPOSE_OTP_IN_RESPONSE line left in your .env is ignored.

# --- video upload / playback -------------------------------------------
# Must stay ABOVE the 16 MiB upload chunk or Django rejects every real chunk.
# DATA_UPLOAD_MAX_MEMORY_SIZE=20971520
# VIDEO_MAX_BYTES=4294967296          # 4 GiB total per video
# VIDEO_PLAYBACK_TTL_SECONDS=120      # signed playback URL lifetime (seconds)
# VIDEO_PROVIDER=local
# MEDIA_ROOT=/var/lib/madar/private-media
# Hand streaming to nginx instead of Django (internal location):
# VIDEO_XACCEL_PREFIX=/protected-media

# --- lesson transcription (content/transcription.py) ---------------------------
# TRANSCRIPTION_MODEL=small          # tiny | base | small | medium | large-v3
# TRANSCRIPTION_DEVICE=cpu           # cpu (default) | cuda (needs CUDA libs)
# TRANSCRIPTION_LANGUAGE=            # empty = auto-detect; or e.g. ar
# TRANSCRIPTION_BACKGROUND=thread    # "worker" => run `manage.py transcribe_videos`

# --- LLM client foundation (ai/llm.py, ai/gemini.py) ---------------------------
# DEVELOPMENT adapter. Nothing in the product calls it yet; verify with
#   python manage.py check_llm_provider [--config-only]
# Never commit a real key. Free-tier data may be used by Google to improve its
# products and reviewed by humans: do NOT send confidential or personal content,
# and do not use a free-tier key in production.
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=                    # create in Google AI Studio; keep in .env only
# GEMINI_MODEL=                      # REQUIRED, no default: pick an id from Google's current model list
# LLM_TIMEOUT_SECONDS=60             # per connect/read, not a total deadline
# LLM_MAX_OUTPUT_TOKENS=0            # 0 = provider default
# LLM_MAX_RETRIES=2                  # transient errors only (429 / timeout / network / 5xx); 0-5
# LLM_RETRY_BASE_SECONDS=1           # exponential backoff base (with jitter)
# LLM_RETRY_MAX_WAIT_SECONDS=30      # longer Retry-After than this => fail fast, no sleep

# --- AI Quiz generation (ai/quiz_generation.py) -------------------------------
# AI_PROVIDER=llm                    # default "stub". "llm" = quizzes are written by the model
# QUIZ_LANGUAGE=                     # REQUIRED with AI_PROVIDER=llm, no default: ar-msa | ar-eg | en
# QUIZ_MAX_ATTEMPTS=2                # model calls per quiz (1 + corrective regenerations), 1-3
# QUIZ_MIN_SOURCE_CHARS=400          # less lesson material than this => explicit "insufficient source"

# --- Billing / Kashier payments (billing/providers/kashier.py) --------------------
# NAMES ONLY here. Real values live in the production secret store, never in git.
# Keys are MODE-SPECIFIC: a test key never validates live traffic and vice versa.
# PAYMENT_PROVIDER=kashier           # "fake" is refused when DJANGO_DEBUG=False
PAYMENT_PROVIDER=
KASHIER_MODE=test                   # test | live
KASHIER_MERCHANT_ID=
KASHIER_PAYMENT_API_KEY_TEST=
KASHIER_PAYMENT_API_KEY_LIVE=
KASHIER_SECRET_KEY_TEST=
KASHIER_SECRET_KEY_LIVE=
KASHIER_API_BASE_TEST=https://test-api.kashier.io
KASHIER_API_BASE_LIVE=https://api.kashier.io
KASHIER_FEP_BASE_TEST=https://test-fep.kashier.io
KASHIER_FEP_BASE_LIVE=https://fep.kashier.io
# Public HTTPS URL Kashier posts payment results to (the ONLY unauthenticated inbound route).
KASHIER_WEBHOOK_URL=
# FRONTEND route the teacher returns to after the hosted page (display only), e.g. https://app.example.com/app/billing
BILLING_CHECKOUT_RETURN_URL=
# BILL-EXT-01: agreement cadence values come from Kashier's written answer; deliberately NO defaults.
KASHIER_AGREEMENT_TYPE=
KASHIER_AGREEMENT_PAYMENT_FREQUENCY=
KASHIER_AGREEMENT_MIN_DAYS_BETWEEN=
KASHIER_AGREEMENT_EXPIRY_DATE=
KASHIER_AGREEMENT_NUMBER_OF_PAYMENTS=
# Live charging kill switch. Keep False until BILL-WU-026 passes.
BILLING_RENEWALS_LIVE_ENABLED=False
