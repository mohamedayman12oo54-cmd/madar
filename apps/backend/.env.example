# Copy this file to .env and fill in real values before deploying.
# NEVER commit the real .env file (it is git-ignored).
#
# With DJANGO_DEBUG=False the app REFUSES TO START on: a missing/placeholder/
# short DJANGO_SECRET_KEY, an empty or "*" DJANGO_ALLOWED_HOSTS, or any
# non-https CORS/CSRF origin.

# >= 50 random characters. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
# Explicit hostnames only (no "*").
DJANGO_ALLOWED_HOSTS=api.your-domain.com
DJANGO_TIME_ZONE=Africa/Cairo

# Comma-separated, https only, no trailing slashes, no wildcards.
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-frontend-domain.com

# --- reverse proxy / client IP (rate limiting depends on this) --------------
# Number of trusted reverse proxies that APPEND the real client address to
# X-Forwarded-For. 0 = trust none (header ignored; safe default). If Django
# sits behind exactly one proxy that you control, set 1.
DJANGO_NUM_PROXIES=0
# Set True ONLY when a TLS-terminating proxy in front of Django overwrites
# X-Forwarded-Proto (otherwise SECURE_SSL_REDIRECT loops or can be spoofed).
DJANGO_BEHIND_TLS_PROXY=False

# --- shared cache for rate-limit counters -----------------------------------
# "db" (default when DEBUG=False; run `python manage.py createcachetable` once
# per deployment) or "locmem" (default in DEBUG; per-process, dev only).
# DJANGO_CACHE_BACKEND=db

# --- HTTPS / HSTS (defaults shown apply when DEBUG=False) --------------------
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_HSTS_SECONDS=2592000
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=True
# DJANGO_HSTS_PRELOAD=True

# PostgreSQL is the only supported database (required):
DB_NAME=madar
DB_USER=madar
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Persistent connections (recommended):
DB_CONN_MAX_AGE=60
DB_CONN_HEALTH_CHECKS=True

# --- OTP delivery: email (Gmail SMTP) -----------------------------------------
# Teachers (signup) and students (activation) may choose to receive the code by
# email. In DEBUG Django defaults to the CONSOLE backend: the email is only
# printed in the runserver terminal and nothing reaches the inbox. To really
# send through Gmail set EMAIL_BACKEND to smtp and fill the rest.
#
# Gmail needs an APP PASSWORD (not the account password):
#   Google Account -> Security -> turn on 2-Step Verification -> App passwords
#   -> create one for "Mail" -> paste the 16 characters below (no spaces).
# Verify the setup (sends a real code to the address you give):
#   python manage.py check_otp_delivery --email you@gmail.com
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=madarplatform6@gmail.com
EMAIL_HOST_PASSWORD=wdrrhbyfzafohvyq
# Shown to the recipient as the sender. Gmail rewrites it to EMAIL_HOST_USER.
DEFAULT_FROM_EMAIL=Madar <madarplatform6@gmail.com>

# --- OTP delivery: SMS ---------------------------------------------------------
# There is NO built-in SMS provider. The default backend only logs and, outside
# DEBUG, refuses to pretend a message was sent. Point this at a class that has
# send(phone, message) (see accounts/delivery.py) once an SMS account exists:
# OTP_SMS_BACKEND=accounts.sms_providers.YourProvider

# --- local development only ---------------------------------------------------
# The OTP code is never returned in API responses (not configurable). Read it
# from the runserver terminal (console email backend) or your real inbox.
# Any EXPOSE_OTP_IN_RESPONSE line left in your .env is ignored.

# --- video upload / playback -------------------------------------------
# Must stay ABOVE the 16 MiB upload chunk or Django rejects every real chunk.
# DATA_UPLOAD_MAX_MEMORY_SIZE=20971520
# VIDEO_MAX_BYTES=4294967296          # 4 GiB total per video
# VIDEO_PLAYBACK_TTL_SECONDS=120      # signed playback URL lifetime (seconds)
# VIDEO_PROVIDER=local
# MEDIA_ROOT=/var/lib/madar/private-media
# Hand streaming to nginx instead of Django (internal location):
# VIDEO_XACCEL_PREFIX=/protected-media
